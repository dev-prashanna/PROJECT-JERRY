# ---------------------------------------------------------------------------
# Moondream Live VQA — environment configuration (copy to `.env` and edit)
# ---------------------------------------------------------------------------
# Every value is optional: the defaults below are the ones the application
# uses when nothing is set.  Real environment variables always win over this
# file.  NOTE: this project parses `.env` itself, so no extra dependency is
# required.

# --- Model -------------------------------------------------------------------
# Path to the ALREADY INSTALLED Moondream 2 checkpoint (the folder that
# contains config.json and model.safetensors).  Leave empty to auto-detect
# `../models/moondream2`.  Nothing is ever downloaded.
MODEL_PATH=

# --- Inference ---------------------------------------------------------------
# auto | cuda | cpu
VQA_DEVICE=auto
# auto | bf16 | fp16 | fp32   (auto = bf16 on CUDA, fp32 on CPU)
VQA_DTYPE=auto
# Maximum answer length in tokens (shorter = snappier answers).
VQA_MAX_NEW_TOKENS=256
# 0.0 = greedy/deterministic; Moondream's own default is 0.5.
VQA_TEMPERATURE=0.0
# Append "answer only from visible evidence …" to every question (1/0).
VQA_GROUNDING=1
# Optional longest-side resize before encoding (0 = keep full resolution).
# Benchmarking showed no meaningful speed-up and a risk to small detail, so
# the default preserves the original frame.
VQA_MAX_SIDE=0
# How many questions may wait behind the one being answered (0 = reject
# while busy).  The queue is never unbounded.
VQA_QUEUE_SIZE=1
# 1 = never touch the network (uses the Hugging Face cache for the tokenizer).
# Set to 0 only on a machine whose cache is empty and that has internet access.
VQA_OFFLINE=1
# Seconds to wait for an in-flight request when the window is closed.
VQA_SHUTDOWN_TIMEOUT=10

# --- Camera ------------------------------------------------------------------
VBMD_CAMERA_INDEX=0
VBMD_CAMERA_WIDTH=640
VBMD_CAMERA_HEIGHT=480
VBMD_CAMERA_FPS=30
# MJPG is strongly recommended: uncompressed YUYV on UVC webcams can collapse
# to ~5 FPS.  Set to an empty value to let the driver choose.
VBMD_CAMERA_FOURCC=MJPG
# auto | v4l2 | any
VBMD_CAMERA_BACKEND=auto
# Reopen the camera automatically after a disconnect (1/0).
VBMD_CAMERA_AUTO_RECONNECT=1

# --- Logging -----------------------------------------------------------------
VQA_LOG_LEVEL=INFO
# VQA_LOG_FILE=/home/you/logs/vqa.log
