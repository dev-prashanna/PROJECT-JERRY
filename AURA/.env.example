# AURA configuration — copy to `.env` and fill in.
#   cp .env.example .env && chmod 600 .env
# Real keys live in `.env` (gitignored). Never commit secrets.

# --- Chat LLM provider (routing + response composition) --------------------
# Pick ONE backend. Groq is the default (free tier).
#
#   LLM_PROVIDER   groq | openai | anthropic | moonshot | deepseek | mimo |
#                  openai_compat   (anything OpenAI-API-shaped: vLLM, Ollama,
#                                   LM Studio, Together, Mistral, ...)
#                  Unknown names are treated as openai_compat.
#   LLM_API_KEY    key for the selected provider (overrides the per-provider env)
#   LLM_BASE_URL   endpoint override (required for openai_compat)
#   LLM_MODEL      model id (falls back to the provider default)
#   LLM_FALLBACK_MODEL  secondary model, same provider
#
# Each provider also reads its own key env var if LLM_API_KEY is unset:
#   groq     GROQ_API_KEY
#   openai   OPENAI_API_KEY
#   anthropic ANTHROPIC_API_KEY
#   moonshot MOONSHOT_API_KEY (or KIMI_API_KEY)
#   deepseek DEEPSEEK_API_KEY
#   mimo     MIMO_API_KEY
#
# Legacy Groq-only variables (GROQ_MODEL, GROQ_FALLBACK_MODEL, GROQ_BASE_URL)
# still work while LLM_PROVIDER=groq.
LLM_PROVIDER=groq
#LLM_API_KEY=
#LLM_BASE_URL=
#LLM_MODEL=
#LLM_FALLBACK_MODEL=

# --- Groq cloud LLM (legacy / default provider) ----------------------------
# Free key: https://console.groq.com/keys
# NOTE: llama-3.3-70b-versatile is not available on every account;
#       openai/gpt-oss-120b is a safe default.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Vision (VLM) provider --------------------------------------------------
#   VLM_PROVIDER   moondream (local default) | openai | groq | openai_compat
#   VLM_MODEL      cloud model id when the provider is not moondream
#   VLM_API_KEY    key for the selected vision backend
#   VLM_BASE_URL   endpoint override (openai_compat / groq vision)
VLM_PROVIDER=moondream
#VLM_MODEL=
#VLM_API_KEY=
#VLM_BASE_URL=

# --- Monocular depth (Depth Anything V2, shown beside the camera) ----------
# Feeds the GUI preview and near/far hints to the vision model.
#   DEPTH_DEVICE      auto | cuda | cpu
#   DEPTH_PRECISION   autocast_bf16 | autocast_fp16 | fp32
#   DEPTH_COLORMAP    TURBO | JET | INFERNO | MAGMA | VIRIDIS | CIVIDIS
DEPTH_ENABLED=true
#DEPTH_DEVICE=auto
#DEPTH_PRECISION=autocast_bf16
#DEPTH_COLORMAP=TURBO
#DEPTH_MAX_FPS=12

# --- Routing / response behaviour ----------------------------------------
# ROUTER_MODE: llm | deterministic | auto | compare
# RESPONSE_STRATEGY: auto | full | direct
ROUTER_MODE=llm
RESPONSE_STRATEGY=auto

# --- Device overrides (indexes from `python3 -c "import sounddevice as sd; print(sd.query_devices())"`) ---
# Leave unset to auto-pick the system default.
#MICROPHONE_DEVICE=default   # or a sounddevice index/name
#TTS_OUTPUT_DEVICE=7
#CAMERA_INDEX=0

# --- Model weight locations (defaults resolve to ../models/...) -----------
#MOONDREAM_MODEL_PATH=
#KOKORO_MODEL_PATH=
#WHISPER_MODEL=small.en

# --- Timeouts / budgets (seconds unless noted) ----------------------------
#GROQ_TIMEOUT_S=25
#GROQ_MAX_RETRIES=2
#GROQ_MAX_COMPLETION_TOKENS=1024
#TOOL_TIMEOUT_S=30
#VLM_MAX_NEW_TOKENS=128
