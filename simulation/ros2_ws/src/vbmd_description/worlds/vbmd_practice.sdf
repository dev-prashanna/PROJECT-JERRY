          <always_on>true</always_on>
          <update_rate>20</update_rate>
          <visualize>false</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>9</samples>
                <resolution>1</resolution>
                <min_angle>-0.1308996938995747</min_angle>
                <max_angle>0.1308996938995747</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.02</min>
              <max>4.0</max>
              <resolution>0.001</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0</mean>
              <stddev>.004</stddev>
            </noise>
          </lidar>
        </sensor>
      </link>
      <joint name="right_ultrasonic_joint" type="fixed">
        <parent>base_link</parent>
        <child>right_ultrasonic_link</child>
      </joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>front_left_wheel_joint</left_joint>
        <left_joint>rear_left_wheel_joint</left_joint>
        <right_joint>front_right_wheel_joint</right_joint>
        <right_joint>rear_right_wheel_joint</right_joint>
        <wheel_separation>.136</wheel_separation>
        <wheel_radius>.03</wheel_radius>
        <topic>/model/vbmd/cmd_vel</topic>
        <odom_topic>/sim/privileged/wheel_odometry</odom_topic>
        <tf_topic>/sim/privileged/odom_tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>20</odom_publish_frequency>
        <max_linear_velocity>.22</max_linear_velocity>
        <min_linear_velocity>-.22</min_linear_velocity>
        <max_angular_velocity>2</max_angular_velocity>
        <min_angular_velocity>-2</min_angular_velocity>
        <max_linear_acceleration>.4</max_linear_acceleration>
        <max_angular_acceleration>2</max_angular_acceleration>
      </plugin>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/model/vbmd/joint_state</topic>
        <joint_name>front_left_wheel_joint</joint_name>
        <joint_name>rear_left_wheel_joint</joint_name>
        <joint_name>front_right_wheel_joint</joint_name>
        <joint_name>rear_right_wheel_joint</joint_name>
      </plugin>
      <pose>0 0 .003 0 0 0</pose>
    </model>
  </world>
</sdf>